# ============================================
# Variables de entorno generales de Civitas
# ============================================

# Base de Datos (PostgreSQL en Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civitas_db
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civitas_db?schema=public

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
